FROM node:20-alpine

WORKDIR /app

# Copiar manifiestos primero para optimizar cache de build.
COPY package*.json ./
COPY vite.config.js ./

# Copiar codigo de la aplicacion frontend.
COPY . .

# Registrar entrypoint para automatizar npm install al iniciar contenedor.
COPY docker/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint
RUN chmod +x /usr/local/bin/frontend-entrypoint

EXPOSE 5173
CMD ["/usr/local/bin/frontend-entrypoint"]
